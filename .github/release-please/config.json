{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "sinterklaas-mod",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": false,
      "prerelease": false,
      "extra-files": [
        { "type": "generic", "path": "gradle.properties" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Functionaliteit" },
        { "type": "fix", "section": "Opgeloste problemen" },
        { "type": "perf", "section": "Prestaties" },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "build", "section": "Build & tooling" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "docs", "section": "Documentatie", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Overig", "hidden": true },
        { "type": "style", "section": "Stijl", "hidden": true }
      ]
    }
  }
}
